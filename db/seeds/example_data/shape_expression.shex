   dcterms:title  xsd:string  ;                                # 100.0 %
   ns17:itemProducedBy  @:Project  ;                           # 100.0 %
   ns17:hasCreator__or__sioc_has_owner__or__ns17_hasContributor__or__sioc_has_creator  @:Person  ;                                # 100.0 %
