:Person
{
   rdf:type  [ns17:Person]  ;                                  # 100.0 %
   ns17:isCreatorOf  @:Data  +;                                # 100.0 %
            # 50.0 % obj: @:Data. Cardinality: {1}
            # 50.0 % obj: @:Data. Cardinality: {2}
            # 100.0 % obj: @:SOP. Cardinality: {1}
            # 100.0 % obj: @:Experimental_assay. Cardinality: {1}
            # 50.0 % obj: @:Modelling_analysis. Cardinality: {1}
            # 50.0 % obj: @:Model. Cardinality: {1}
            # 50.0 % obj: @:observation_unit. Cardinality: {1}
            # 50.0 % obj: @:Study. Cardinality: {1}
            # 50.0 % obj: @:Investigation. Cardinality: {1}
            # 50.0 % obj: @:Sample. Cardinality: {6}
   ns17:isAssociatedWith  @:Project  ;                         # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   ns17:seekID  xsd:anyURI  ;                                  # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   foaf:name  xsd:string  ;                                    # 100.0 %
   ns17:description  xsd:string  ;                             # 100.0 %
   foaf:familyName  xsd:string  ;                              # 100.0 %
   foaf:mbox_sha1sum  xsd:string  ;                            # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   foaf:firstName  xsd:string  ;                               # 100.0 %
   sioc:name  xsd:string  ;                                    # 100.0 %
   ns17:isContributorOf  @:Data  *
            # 50.0 % obj: @:Data. Cardinality: {2}
            # 50.0 % obj: @:Sample. Cardinality: {6}
            # 50.0 % obj: @:Modelling_analysis. Cardinality: {1}
            # 50.0 % obj: @:Model. Cardinality: {1}
            # 50.0 % obj: @:observation_unit. Cardinality: {1}
            # 50.0 % obj: @:Strain. Cardinality: {1}
            # 50.0 % obj: @:Publication. Cardinality: {1}
            # 50.0 % obj: @:Study. Cardinality: {1}
            # 50.0 % obj: @:Experimental_assay. Cardinality: {1}
            # 50.0 % obj: @:Investigation. Cardinality: {1}
            # 50.0 % obj: @:SOP. Cardinality: {1}
}


:Organism
{
   rdf:type  [ns17:Organism]  ;                                # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   ns17:isInvestigatedBy  @:Modelling_analysis  ;              # 100.0 %
            # 100.0 % obj: @:Experimental_assay. Cardinality: {1}
   dcterms:title  xsd:string  ;                                # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   ns17:NCBI_ID  xsd:anyURI                                    # 100.0 %
}


:Study
{
   ns17:hasPart  @:Modelling_analysis  ;                       # 100.0 %
            # 100.0 % obj: @:observation_unit. Cardinality: {1}
            # 100.0 % obj: @:Experimental_assay. Cardinality: {1}
   rdf:type  [ns17:Study]  ;                                   # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   ns17:itemProducedBy  @:Project  ;                           # 100.0 %
   ns17:isPartOf  @:Investigation  ;                           # 100.0 %
   ns17:seekID  xsd:anyURI  ;                                  # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   sioc:has_owner__or__sioc_has_creator__or__ns17_hasCreator__or__ns17_hasContributor  @:Person  ;                                 # 100.0 %
   ns17:description  xsd:string  ;                             # 100.0 %
}



:Publication
{
   ns17:description  xsd:string  ;                             # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   rdf:type  [ns17:Publication]  ;                             # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   ns17:isPartOf  @:Modelling_analysis  ;                      # 100.0 %
            # 100.0 % obj: @:Experimental_assay. Cardinality: {1}
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   ns17:itemProducedBy  @:Project  ;                           # 100.0 %
   sioc:has_owner__or__ns17_hasContributor  @:Person                                    # 100.0 %
}


:Project
{
   ns17:title  xsd:string  ;                                   # 100.0 %
   foaf:homepage  xsd:anyURI  ;                                # 100.0 %
   ns17:hasItem  @:SOP  ;                                      # 100.0 %
            # 100.0 % obj: @:Modelling_analysis. Cardinality: {1}
            # 100.0 % obj: @:Publication. Cardinality: {1}
            # 100.0 % obj: @:Data. Cardinality: {2}
            # 100.0 % obj: @:Model. Cardinality: {1}
            # 100.0 % obj: @:Study. Cardinality: {1}
            # 100.0 % obj: @:Experimental_assay. Cardinality: {1}
            # 100.0 % obj: @:Investigation. Cardinality: {1}
   dcterms:title  xsd:string  ;                                # 100.0 %
   rdf:type  [ns17:Project]  ;                                 # 100.0 %
   ns17:isAssociatedWith  @:Person  {2};                       # 100.0 %
   ns17:description  xsd:string  ;                             # 100.0 %
   ns17:webLink  xsd:anyURI  ;                                 # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   ns17:isPartOf  @:Programme  ;                               # 100.0 %
   ns17:investigates  @:Organism  ;                            # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   ns17:seekID  xsd:anyURI                                     # 100.0 %
}



:Sample
{
   rdf:type  [ns17:Sample]  ;                                  # 100.0 %
   sioc:has_creator__or__ns17_hasCreator__or__sioc_has_owner__or__ns17_hasContributor  @:Person  ;                               # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   ns17:hasPart  @:Experimental_assay  ;                       # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   ns21:enzyme  xsd:string  ?
            # 66.66666666666666 % obj: xsd:string. Cardinality: {1}
}


:Service
{
   sd:feature  IRI  {2};                                       # 100.0 %
   sd:resultFormat  IRI  {8};                                  # 100.0 %
   rdf:type  [sd:Service]  ;                                   # 100.0 %
   sd:url  IRI  ;                                              # 100.0 %
   sd:supportedLanguage  IRI  ;                                # 100.0 %
   sd:endpoint  IRI                                            # 100.0 %
}


:Strain
{
   ns17:externalSupplierID  xsd:string  ;                      # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   rdf:type  [ns17:Strain]  ;                                  # 100.0 %
   ns17:description  xsd:string  ;                             # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   ns17:NCBI_ID  xsd:anyURI  ;                                 # 100.0 %
   ns17:hasContributor__or__sioc_has_owner  @:Person                # 100.0 %
}


:Investigation
{
   ns17:description  xsd:string  ;                             # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   ns17:seekID  xsd:anyURI  ;                                  # 100.0 %
   sioc:has_creator__or__ns17_hasCreator__or__ns17_hasContributor__or__sioc_has_owner  @:Person  ;                               # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   rdf:type  [ns17:Investigation]  ;                           # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   ns17:itemProducedBy  @:Project  ;                           # 100.0 %
   ns17:hasPart  @:Study  ;                                    # 100.0 %
   ns17:title  xsd:string                                      # 100.0 %
}


:Data
{
   ns17:description  xsd:string  ;                             # 100.0 %
   dcterms:created  xsd:dateTime  ;                            # 100.0 %
sioc:has_creator__or__ns17_hasContributor__or__sioc_has_owner__or__ns17_hasCreator  @:Person  ;                              # 100.0 %
   ns17:title  xsd:string  ;                                   # 100.0 %
   dcterms:modified  xsd:dateTime  ;                           # 100.0 %
   dcterms:description  xsd:string  ;                          # 100.0 %
   ns17:isPartOf  @:Experimental_assay  ;                      # 100.0 %
            # 100.0 % obj: @:Modelling_analysis. Cardinality: {1}
   rdf:type  [ns17:Data]  ;                                    # 100.0 %
   dcterms:title  xsd:string  ;                                # 100.0 %
   ns17:itemProducedBy  @:Project  ;                           # 100.0 %
